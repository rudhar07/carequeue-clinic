# CareQueue UI server. The nginx image renders /etc/nginx/templates/*.template
# into /etc/nginx/conf.d/ at start-up with envsubst, replacing only variables
# that exist in the environment (so nginx's own $uri, $host... are untouched).
#   BACKEND_URL  upstream for /api
#                Docker Compose: http://backend:8000 (image default)
#                Kubernetes:     http://<release>-backend:8000 (set by Helm)
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # nginx's own probe; does not depend on the backend being up.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Vite puts content-hashed files in /assets, so they can be cached for long.
  # (expires instead of add_header: an add_header here would drop the security headers above.)
  location /assets/ {
    expires 30d;
    try_files $uri =404;
  }

  # Only the API is proxied. /health, /ready and /metrics stay internal to the backend.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
  }

  # Single page app: unknown paths serve index.html (never cached, so new deploys show up).
  location / {
    expires -1;
    try_files $uri /index.html;
  }
}
