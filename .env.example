# Copy to .env to override the docker-compose.yml defaults.
# FAKE demo values only. Never commit a real .env.
POSTGRES_USER=carequeue
POSTGRES_PASSWORD=carequeue-local-only
POSTGRES_DB=carequeue
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
CLINIC_TIMEZONE=Asia/Kolkata
# Seed demo doctors/patients, and fill today's queue with demo visits
RUN_SEED=true
SEED_DEMO_QUEUE=true
FRONTEND_PORT=3000
GIT_SHA=local
